# Qwen3.6 vLLM configuration for DGX Spark / GB10
QWEN36_VLLM_IMAGE=ghcr.io/aeon-7/aeon-vllm-ultimate:2026-06-18-v0.23.0-dflashfix
VLLM_HOSTNAME=qwen.example.com
# Host directory containing qwen36-nvfp4/ and qwen36-dflash/.
# Example: /srv/qwen36
QWEN36_MODELS_DIR=/path/to/qwen36
QWEN36_SERVED_MODEL_NAMES=qwen36-35b-heretic qwen36-fast qwen36-deep

VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_DTYPE=auto
VLLM_QUANTIZATION=compressed-tensors

# Memory/context knobs. Defaults follow AEON's validated GB10 profile.
VLLM_GPU_MEMORY_UTILIZATION=0.70
VLLM_MAX_MODEL_LEN=262144
VLLM_MAX_NUM_SEQS=64
VLLM_MAX_NUM_BATCHED_TOKENS=65536

VLLM_SPECULATIVE_CONFIG={"method":"dflash","model":"/models/qwen36-dflash","num_speculative_tokens":11}
VLLM_ATTENTION_BACKEND=flash_attn
VLLM_NVIDIA_GPU_COUNT=all
