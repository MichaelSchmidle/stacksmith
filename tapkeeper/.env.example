# Required: ghcr.io/michaelschmidle/tapkeeper@sha256:<actual published digest>
# No image is published by a PR build. Release/pull verification comes first.
TAPKEEPER_IMAGE=
TAPKEEPER_CONFIG_FILE=
TAPKEEPER_TOKEN_FILE=
TAPKEEPER_DATA_DIR=
# Owner and private chat IDs must be the same positive integer.
TAPKEEPER_USER_ID=
TAPKEEPER_CHAT_ID=
TZ=Europe/Zurich
TAPKEEPER_MORNING=10:00
TAPKEEPER_EVENING=20:00
# Keep token contents in TAPKEEPER_TOKEN_FILE, never in this environment file.
# For backup reuse, fill every value literally: no quotes, expansion or inline comments.
