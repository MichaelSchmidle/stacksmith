# LiteLLM configuration
# Official proxy docs:
# https://docs.litellm.ai/docs/proxy/deploy
TZ=Europe/Zurich

# Hostname served by Traefik on the Tailscale entrypoint
LITELLM_HOSTNAME=litellm.example.com

# Local access in addition to Traefik
LITELLM_PORT=4000

# Required LiteLLM proxy secret. Generate with:
#   printf 'sk-'; openssl rand -hex 32
# LiteLLM expects keys to start with sk-.
LITELLM_MASTER_KEY=sk-change-me-generate-with-openssl-rand-hex-32

# Required secret used by LiteLLM for key hashing/encryption. Keep stable.
# Generate with:
#   openssl rand -hex 32
LITELLM_SALT_KEY=change-me-generate-with-openssl-rand-hex-32

# LiteLLM admin UI bootstrap credentials. Change before first deploy.
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-me

# Postgres backing store for LiteLLM config, keys, budgets, and logs.
LITELLM_POSTGRES_DB=litellm
LITELLM_POSTGRES_USER=litellm
LITELLM_POSTGRES_PASSWORD=change-me
