PAPERLESS_HOSTNAME=paperless.example.com
TZ=Europe/Zurich

# Required: generate two different values; do not deploy this template unchanged.
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=
PAPERLESS_DB_PASSWORD=

# Absolute paths on the Docker host, pre-created with the UID/GID below.
# Dedicated directories only: Paperless consumes (removes) successfully imported files.
PAPERLESS_CONSUME_DIR=/srv/paperless/consume
PAPERLESS_EXPORT_DIR=/srv/paperless/export
PAPERLESS_UID=1000
PAPERLESS_GID=1000

# Poll every 10 seconds (works with network-mounted intake); 0 uses local filesystem events.
PAPERLESS_CONSUMER_POLLING_INTERVAL=10

# Optional managed storage filenames; blank keeps Paperless's default naming.
# Example: {{ created }} {{ correspondent }} {{ document_type }} - {{ doc_pk }}
# Paperless adds the extension; created is the document date, not the scan date.
PAPERLESS_FILENAME_FORMAT=
