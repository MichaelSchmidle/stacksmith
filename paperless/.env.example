PAPERLESS_HOSTNAME=paperless.example.com
TZ=Europe/Zurich

# Required: generate two different values; do not deploy this template unchanged.
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=
PAPERLESS_DB_PASSWORD=

# Absolute paths on the Docker host, pre-created with the UID/GID below.
# Dedicated directories only: Paperless consumes (removes) successfully imported files.
PAPERLESS_CONSUME_DIR=/srv/paperless/consume
PAPERLESS_EXPORT_DIR=/srv/paperless/export
PAPERLESS_UID=1000
PAPERLESS_GID=1000

# 0: filesystem events for local intake; e.g. 10 seconds for network-mounted intake.
PAPERLESS_CONSUMER_POLLING=0
