# Obsidian web desktop configuration
# Official image docs:
# https://docs.linuxserver.io/images/docker-obsidian/
TZ=Europe/Zurich

# Hostname served by Traefik on the Tailscale entrypoint
OBSIDIAN_HOSTNAME=obsidian.example.com

# Run the container processes as the vault-owning host user.
# On jade1-nue, michael is currently uid/gid 1000.
OBSIDIAN_PUID=1000
OBSIDIAN_PGID=1000

# Existing Syncthing-backed vault on the Docker host.
# This is mounted inside the container at /config/vault.
OBSIDIAN_VAULT_PATH=/home/michael/ObsidianVault

# Basic HTTP auth for the LinuxServer/Selkies web desktop.
# Keep Tailscale/Traefik access controls as the primary boundary; this is a second lock.
OBSIDIAN_CUSTOM_USER=michael
OBSIDIAN_PASSWORD=change-me

# Browser page title
OBSIDIAN_TITLE=Obsidian
