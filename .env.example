# Service Hostnames
PORTAINER_HOSTNAME=mgmt.example.com
TRAEFIK_HOSTNAME=prxy.example.com

# Custom logo shown in the Portainer sidebar (must be a browser-reachable URL)
PORTAINER_LOGO_URL=https://cdn.jsdelivr.net/gh/MichaelSchmidle/stacksmith@main/assets/brand/logo/stacksmith-lockup-on-dark.svg

# Network Interfaces
# Tailscale IP (always present, dashboard accessible here via TRAEFIK_HOSTNAME)
TRAEFIK_TAILSCALE_IP=100.64.0.1
# Secondary IP (optional: private/public IP for other services, use 127.0.0.1 if not needed)
TRAEFIK_SECONDARY_IP=127.0.0.1

# Let's Encrypt / ACME
ACME_EMAIL=your-email@example.com
CLOUDFLARE_DNS_API_TOKEN=your-cloudflare-api-token
