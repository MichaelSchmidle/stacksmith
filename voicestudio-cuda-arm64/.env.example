# Tailnet-routed DNS hostname, without scheme or path.
VOICESTUDIO_HOSTNAME=studio.example.com

# Required administrator credential; generate a long random value before deployment.
# Example: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
VOICESTUDIO_API_KEY=

# Container resource ceilings; model workloads may need a larger memory allowance.
VOICESTUDIO_CPU_LIMIT=4
VOICESTUDIO_MEMORY_LIMIT=16G
TZ=Europe/Zurich
