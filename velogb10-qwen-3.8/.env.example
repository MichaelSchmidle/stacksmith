# Local runtime image built from the pinned upstream release.
VELOGB10_IMAGE_REPOSITORY=stacksmith_velogb10_qwen_3_8
VELOGB10_CUDA_IMAGE=nvidia/cuda:13.0.2-runtime-ubuntu24.04@sha256:6a0e31b59e70890446f2c17356d6efc0d54260090a8c63d6ca7c2ad049db95d2
VELOGB10_VERSION=0.5.0
VELOGB10_RELEASE_SHA256=1d0a564a1874febf34e011c35e6c2fd649239d5af8b838d3fdb41f942fb9b1c7
VELOGB10_SOURCE_COMMIT=89242407e799930e9f4e51559bffc186033d90a7
VELOGB10_LICENSE_SHA256=c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4

VELOGB10_HOSTNAME=velo.example.com
# Comma-separated trusted client CIDRs. Replace TEST-NET with the LiteLLM host and canary clients.
VELOGB10_ALLOWED_SOURCE_RANGES=192.0.2.0/24
# Host directory containing qwen38-nvfp4-full/ and qwen38-dflash2/.
VELOGB10_MODELS_DIR=/path/to/velogb10-models
VELOGB10_SERVED_MODEL_NAME=qwen3.8-27b-velo

# Single-user canary defaults. Raise context deliberately after checking memory headroom.
VELOGB10_CONTAINER_MEMORY=100g
VELOGB10_SHM_SIZE=16g
VELOGB10_CPUSET=5-9,15-19
VELOGB10_MAX_SEQ_LEN=65536
VELOGB10_MAX_BATCH=1
VELOGB10_DEFAULT_MAX_TOKENS=8192
VELOGB10_PREFIX_CACHE=on
VELOGB10_PRESENCE_PENALTY=1.5
VELOGB10_REASONING_EFFORT=medium
VELOGB10_NVIDIA_GPU_COUNT=all
TZ=Europe/Zurich
