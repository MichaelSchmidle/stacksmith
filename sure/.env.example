# Tailnet-routed HTTPS hostname, without scheme or trailing slash.
SURE_HOSTNAME=finance.example.com
TZ=Europe/Zurich

# Required: generate independently; never use the upstream example secrets.
# openssl rand -hex 64
SURE_SECRET_KEY_BASE=
# openssl rand -hex 32
SURE_DB_PASSWORD=

# Required for native database-field encryption: run openssl rand -hex 32
# independently for EACH key. Preserve all three with recovery credentials;
# never regenerate them during an ordinary restart or update.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Optional: leave BOTH empty until the intended Sure user exists.
# MCP can read and modify that user's financial records.
# openssl rand -hex 32
SURE_MCP_API_TOKEN=
SURE_MCP_USER_EMAIL=
