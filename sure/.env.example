# Tailnet-routed HTTPS hostname, without scheme or trailing slash.
SURE_HOSTNAME=finance.example.com
TZ=Europe/Zurich

# Required: generate independently; never use the upstream example secrets.
# openssl rand -hex 64
SURE_SECRET_KEY_BASE=
# openssl rand -hex 32
SURE_DB_PASSWORD=

# Optional: leave BOTH empty until the intended Sure user exists.
# MCP can read and modify that user's financial records.
# openssl rand -hex 32
SURE_MCP_API_TOKEN=
SURE_MCP_USER_EMAIL=
