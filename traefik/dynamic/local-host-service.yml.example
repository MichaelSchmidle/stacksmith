# Example file-provider route for a service bound to the Docker host loopback.
#
# To use:
# 1. Copy this file to ${TRAEFIK_DYNAMIC_CONFIG_DIR:-traefik/dynamic}/local-host-service.yml.
# 2. Replace the hostname and upstream URL.
# 3. Restart Traefik or keep providers.file.watch=true for live reload.
#
# Keep site-specific hostnames out of the public template repo.

http:
  routers:
    local-host-service:
      rule: "Host(`service.example.com`)"
      entryPoints:
        - websecure-tailscale
      service: local-host-service
      tls:
        certResolver: stacksmith
      middlewares:
        - secure-headers@docker

  services:
    local-host-service:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:11000"
