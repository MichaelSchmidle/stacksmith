# Network Interfaces
# Traefik uses host networking and binds directly to these host IPs on ports 80/443.
# Tailscale IP (always present, dashboard accessible here via TRAEFIK_HOSTNAME)
TRAEFIK_TAILSCALE_IP=100.64.0.1
# Secondary IP for services using the websecure-secondary entrypoint.
# Use a distinct loopback address such as 127.0.0.2 if not needed; it must not equal TRAEFIK_TAILSCALE_IP.
TRAEFIK_SECONDARY_IP=127.0.0.2

# Hostnames
# Dashboard hostname (resolves to Tailscale IP)
TRAEFIK_HOSTNAME=prxy.example.com

# Let's Encrypt / ACME
ACME_EMAIL=your-email@example.com
CLOUDFLARE_DNS_API_TOKEN=your-cloudflare-api-token

