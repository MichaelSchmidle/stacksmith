# Qwen3.8 SGLang configuration for DGX Spark / GB10
QWEN38_SGLANG_IMAGE=lmsysorg/sglang@sha256:febfb971c7352570fc445c466ebd6ffc9d896024958e544a60f2137fd85856b1
SGLANG_HOSTNAME=qwen.example.com
SGLANG_API_KEY=
# Host directory containing qwen38-nvfp4/ and qwen38-dspark/.
QWEN38_MODELS_DIR=/path/to/qwen38
# Absolute host path to the patched template committed with this stack.
QWEN38_CHAT_TEMPLATE_FILE=/path/to/qwen38/chat-template-sglang.jinja
QWEN38_SERVED_MODEL_NAME=qwen3.8-27b

# GB10 safety and scheduler settings validated by the upstream recipe.
# Do not raise SGLANG_MEM_FRACTION_STATIC above 0.50 on unified memory.
SGLANG_CONTAINER_MEMORY=100g
SGLANG_SHM_SIZE=16g
SGLANG_MEM_FRACTION_STATIC=0.50
SGLANG_CPUSET=5-9,15-19
SGLANG_CHUNKED_PREFILL_SIZE=8192
SGLANG_MAX_MAMBA_CACHE_SIZE=96
SGLANG_MAX_RUNNING_REQUESTS=8
SGLANG_NVIDIA_GPU_COUNT=all
