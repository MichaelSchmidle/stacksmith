# Ignore all .env files everywhere
.env
**/.env

# Ignore local Claude settings
.claude/settings.local.json

# Ignore local mkcert certificates
traefik/certs/

# Ignore deployment-specific dynamic Traefik routes; keep *.example templates tracked.
traefik/dynamic/local-*.yml
traefik/dynamic/local-*.yaml
# Python bytecode
__pycache__/
*.py[cod]
