# Open Design configuration
# Official Docker deployment docs:
# https://github.com/nexu-io/open-design/tree/main/deploy
TZ=Europe/Zurich

# Hostname served by Traefik on the Tailscale entrypoint
OPEN_DESIGN_HOSTNAME=design.example.com

# Container memory limit
OPEN_DESIGN_MEM_LIMIT=384m

# Allowed browser origins for /api calls when accessed through Traefik.
# Keep this aligned with OPEN_DESIGN_HOSTNAME.
OPEN_DESIGN_ALLOWED_ORIGINS=https://design.example.com

# Required daemon token. Generate with:
#   openssl rand -hex 32
OD_API_TOKEN=change-me-generate-with-openssl-rand-hex-32
