TZ=Europe/Zurich
TALLYPORT_CPU_LIMIT=0.5
TALLYPORT_MEMORY_LIMIT=256m
TALLYPORT_PIDS_LIMIT=64

# Absolute Docker-host paths. Keep deployment values out of this repository.
# Configuration and API-key files must already exist and be readable by 10001:10001.
TALLYPORT_CONFIG_FILE=
TALLYPORT_API_KEY_FILE=
# Restricted NAS intake share, already mounted and writable by 10001:10001.
TALLYPORT_INTAKE_DIR=
# Local persistent storage, not SMB/NFS; writable only by the runtime owner.
TALLYPORT_STATE_DIR=
