# Buzz relay image pinned to an immutable multi-architecture digest from upstream main.
# Update deliberately after reviewing https://github.com/block/buzz/releases and deployment changes.
BUZZ_IMAGE=ghcr.io/block/buzz:sha-96ae141@sha256:472e9cf7cfee069198ea038a923ed63cbaea48954615f082d6c82149f5917975

# Private Traefik-routed hostname.
BUZZ_HOSTNAME=buzz.example.com

# Closed-relay identities. Generate owner and relay keypairs separately with buzz-admin.
BUZZ_RELAY_OWNER_PUBKEY=CHANGE_ME_64_HEX_OWNER_PUBLIC_KEY
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_RELAY_PRIVATE_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX

# Internal data services.
BUZZ_POSTGRES_DB=buzz
BUZZ_POSTGRES_USER=buzz
BUZZ_POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
BUZZ_REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
BUZZ_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
BUZZ_S3_BUCKET=buzz-media

# Private pilot defaults.
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_REQUIRE_MEDIA_GET_AUTH=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
TZ=Europe/Zurich
