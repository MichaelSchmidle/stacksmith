# NVIDIA Nemotron 3.5 Super VL: SGLang + LiLiCorr, single DGX Spark / GB10.
TZ=Europe/Zurich
NEMOTRON_HOSTNAME=nemotron.example.com
# Required: generate a strong random token; never commit the deployment value.
NEMOTRON_API_KEY=
# Required: absolute directory on the Docker endpoint, containing nvfp4/ and lilicorr/.
NEMOTRON_MODELS_DIR=

# Initial commissioning limits, NOT a measured memory-fit guarantee.
# Context is shared by prompt, image tokens and generated output.
NEMOTRON_CONTEXT_LENGTH=32768
# Do not copy the smaller Qwen stack's 0.50: this target's weights alone exceed that pool.
# Higher fractions can exhaust unified memory; validate under supervision before tuning.
NEMOTRON_MEM_FRACTION_STATIC=0.80
